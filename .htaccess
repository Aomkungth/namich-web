# DirectAdmin / Apache Configuration

# Set Default Charset
AddDefaultCharset UTF-8

# Prevent directory listing
Options -Indexes

# Protect sensitive files
<FilesMatch "^(schema\.sql|\.env|\.git)">
    Order allow,deny
    Deny from all
</FilesMatch>

# Enable PHP Error Logging (if needed)
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value memory_limit 128M
</IfModule>
